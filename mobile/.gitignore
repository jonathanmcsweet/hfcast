node_modules/
.expo/
dist/
web-build/
*.log
.DS_Store

# Generated by `expo prebuild` from app.json, and rewritten by it each
# time. Nothing in here is edited by hand.
/android/
/ios/

# Built by modules/engine-bridge/build-rust.sh, one shared library per ABI.
modules/*/android/src/main/jniLibs/
modules/*/rust/target/

# Where tools/build-android.sh puts the finished APKs, and the copy of this
# tree it builds the legacy one in. Both are generated; only
# legacy/package.json and legacy/pnpm-lock.yaml are kept.
/build/

# CanvasKit, the Skia runtime for web: about 8 MB, copied out of
# node_modules by tools/copy-canvaskit.sh so it is always the build that
# matches the installed package. A committed copy would be 8 MB of
# binary in the history and would go stale against the JavaScript API
# the next Skia upgrade brings, which fails at run time rather than at
# build time.
public/canvaskit.wasm

# Playwright: the browser's own output. `test/e2e/` is the suite and is
# kept; these two are what a run leaves behind.
/test-results/
/playwright-report/
