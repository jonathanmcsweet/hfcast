    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.5",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.3",
    "react-test-renderer": "^19.2.3",
    "topojson-client": "^3.1.0",
    "typescript": "~7.0.2",
    "world-atlas": "^2.0.2"
  },
  "private": true
