{
  "name": "hfcast",
  "version": "0.62.10",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.17.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:render",
    "test:unit": "node --experimental-strip-types --experimental-test-module-mocks --test test/*.test.ts",
    "test:render": "node tools/jest.js",
    "web:export": "bash tools/copy-canvaskit.sh && expo export --platform web",
    "test:e2e": "pnpm web:export && playwright test",
    "test:e2e:only": "playwright test",
    "test:e2e:ui": "playwright test --ui-host=127.0.0.1 --ui-port=9323"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo/metro-runtime": "~57.0.8",
    "@formatjs/intl-datetimeformat": "^6.12.5",
    "@formatjs/intl-getcanonicallocales": "^2.3.0",
    "@formatjs/intl-locale": "^4.0.0",
    "@formatjs/intl-numberformat": "^8.10.3",
    "@formatjs/intl-pluralrules": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native/assets-registry": "0.86.2",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/query-async-storage-persister": "5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "5.101.4",
    "expo": "~57.0.9",
    "expo-asset": "~57.0.8",
    "expo-build-properties": "~57.0.8",
    "expo-clipboard": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.11",
    "i18next": "^23.12.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^15.0.1",
    "react-native": "0.86.2",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "~0.21.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
