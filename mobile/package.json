{
  "name": "hfcast",
  "version": "1.10.1",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.17.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:render",
    "test:unit": "node --experimental-strip-types --experimental-test-module-mocks --test test/*.test.ts",
    "test:render": "node tools/jest.js",
    "web:export": "bash tools/copy-canvaskit.sh && expo export --platform web",
    "test:e2e": "pnpm web:export && playwright test",
    "test:e2e:only": "playwright test",
    "test:e2e:ui": "playwright test --ui-host=127.0.0.1 --ui-port=9323"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@formatjs/intl-datetimeformat": "^7.8.0",
    "@formatjs/intl-getcanonicallocales": "^3.2.12",
    "@formatjs/intl-locale": "^5.3.12",
    "@formatjs/intl-numberformat": "^9.4.3",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native/assets-registry": "0.86.3",
    "@shopify/react-native-skia": "2.11.0",
    "@tanstack/query-async-storage-persister": "5.104.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-persist-client": "5.104.0",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-localization": "~57.0.2",
    "expo-screen-orientation": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.9.0",
    "react-native-svg": "15.15.5",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "~0.21.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@playwright/test": "^1.63.0",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.13",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "^19.2.3",
    "topojson-client": "^3.1.0",
    "typescript": "~7.0.2",
    "world-atlas": "^2.0.2"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "@shopify/react-native-skia"
        ]
      }
    }
  }
}
