node_modules/
dist/
build/
web-build/
.expo/
*.log
.DS_Store

# voacapl build tree and its runtime data directory
vendor/voacapl/
itshfbc/

# One voacapl source copy and build per optimisation level, made by
# hfcast-engine/tools/build-variants.sh
vendor/voacapl-variants/

# ITU-R P.533 reference implementation checkout, about 700 MB
vendor/itu-r-hf/

# Rust build output
target/

# The engine extracted into its own repository. It lives here so the
# editor can see both, but it has its own history and must not be
# committed into this one.
/hfcast-engine/

# The roadmap, the completions ledger and any review written for one
# branch are kept outside this repository. They stay in the working tree
# so a session can read and update them, and must never be committed
# here.
#
# Matched by prefix rather than by exact name. The two rules here were
# `/docs/roadmap.md` and `/docs/roadmap-progress.md`, and the files are
# called `hfcast-roadmap.md` and `hfcast-roadmap-progress.md`, so
# neither rule matched anything and 227 KB sat untracked and unignored.
/docs/*roadmap*.md
/docs/code-review-*.md

# Page snapshots and screenshots the Playwright MCP server writes as it
# browses. They are a record of one session looking at the app, not part
# of the app.
.playwright-mcp/
