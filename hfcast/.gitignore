node_modules/
.expo/
dist/
web-build/
*.log
.DS_Store

# Generated by `expo prebuild` from app.json, and rewritten by it each
# time. Nothing in here is edited by hand.
/android/
/ios/

# Built by modules/hfcast-engine/build-rust.sh, one shared library per ABI.
modules/*/android/src/main/jniLibs/
modules/*/rust/target/

# Where tools/build-android.sh puts the finished APKs, and the copy of this
# tree it builds the legacy one in. Both are generated; only
# legacy/package.json and legacy/pnpm-lock.yaml are kept.
/build/
