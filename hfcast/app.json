{
  "expo": {
    "name": "HFcast",
    "slug": "hfcast",
    "version": "0.23.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.hfcast"
    },
    "android": {
      "package": "com.example.hfcast",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D14"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "splash": {
        "backgroundColor": "#F7F8FC",
        "dark": {
          "backgroundColor": "#0B0D14"
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-font"
    ],
    "splash": {
      "backgroundColor": "#F7F8FC"
    }
  }
}
