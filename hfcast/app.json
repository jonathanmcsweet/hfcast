{
  "expo": {
    "name": "HFcast",
    "slug": "hfcast",
    "version": "0.50.0",
    "icon": "./src/assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "solutions.cloudburner.hfcast"
    },
    "android": {
      "package": "solutions.cloudburner.hfcast",
      "versionCode": 50001,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon-foreground.png",
        "monochromeImage": "./src/assets/icon-monochrome.png",
        "backgroundColor": "#2A1656"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ],
      "splash": {
        "backgroundColor": "#0B0D14",
        "dark": {
          "backgroundColor": "#0B0D14"
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-font",
      "./plugins/withReleaseSigning.ts",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "splash": {
      "backgroundColor": "#0B0D14"
    }
  }
}
