{
  "name": "hfcast-workspace",
  "version": "0.2.0",
  "private": true,
  "description": "Tooling shared by the HFcast app and its prediction server",
  "license": "Apache-2.0",
  "scripts": {
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "dprint check && biome lint .",
    "dev:server": "pnpm --dir server start",
    "dev:app": "pnpm --dir hfcast start",
    "test": "pnpm --dir server test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "dprint": "^0.47.2"
  }
}
