{
  "name": "hfcast-workspace",
  "version": "0.42.1",
  "private": true,
  "description": "Tooling shared by the HFcast app and its prediction server",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "dprint check && biome lint .",
    "dev:server": "pnpm --dir server start",
    "dev:app": "bash tools/dev.sh",
    "test": "pnpm --dir server test",
    "test:e2e": "pnpm --dir mobile test:e2e",
    "test:e2e:only": "pnpm --dir mobile test:e2e:only",
    "test:e2e:ui": "pnpm --dir mobile test:e2e:ui",
    "dev": "bash tools/dev.sh",
    "dev:ui": "pnpm --dir mobile start"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "dprint": "^0.47.2"
  }
}
